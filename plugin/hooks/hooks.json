{
  "description": "gatelight：会话开始时说明测试节奏和写测试的约定（接入了 testcraft 的仓库），直接跑 full 的命令时提醒改用 testpace full；接入了 modwall 的仓库再说明模块列表和写法约定，改文件之前拦下没有归属的代码文件（只看路径）；整组没跑完或结果没看，拦一次结束。合并门是 git 钩子（testpace install）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\" claude", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\" claude", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\" claude", "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\" claude", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\" claude", "timeout": 60 }
        ]
      }
    ]
  }
}
