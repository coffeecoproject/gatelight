{
  "description": "testpace：会话开始时说明测试节奏，直接跑整组命令时提醒改用 testpace full；整组没跑完或结果没看时拦一次结束。合并门是 git 钩子（testpace install）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/testpace.ts\"", "timeout": 60 }
        ]
      }
    ]
  }
}
